Options -Indexes

RewriteEngine On

# Block internal directories and hidden files
RewriteRule ^data(/|$) - [F,L]
RewriteRule ^\. - [F,L]

<FilesMatch "\.(sqlite|sqlite3|db|md|txt|ya?ml)$|^Dockerfile$">
    Require all denied
</FilesMatch>

# Route /<slug>/edit -> edit.php?slug=<slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/edit/?$ edit.php?slug=$1 [L,QSA]

# Route /<slug> -> view.php?slug=<slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ view.php?slug=$1 [L,QSA]
